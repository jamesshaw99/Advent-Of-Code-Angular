{
  "name": "advent-of-code",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ui": "ng test --configuration=ui",
    "generate-challenges": "node generate-challenge-imports.js",
    "start:frontend": "npm run generate-challenges && ng serve",
    "start:backend": "node ./backend/server.js",
    "start": "npm-run-all --parallel start:frontend start:backend",
    "lint": "eslint \"./src/**/*.{ts,html}\" \"./backend/*.{ts,js}\""
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.1.2",
    "@angular/cdk": "^22.1.2",
    "@angular/common": "^22.1.2",
    "@angular/compiler": "^22.1.2",
    "@angular/core": "^22.1.2",
    "@angular/forms": "^22.1.2",
    "@angular/material": "^22.1.2",
    "@angular/platform-browser": "^22.1.2",
    "@angular/router": "^22.1.2",
    "bootstrap": "^5.3.3",
    "rxjs": "~7.8.0",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.1.4",
    "@angular/cli": "^22.1.4",
    "@angular/compiler-cli": "^22.1.2",
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^4.0.8",
    "@vitest/ui": "^4.1.10",
    "angular-eslint": "22.1.0",
    "eslint": "^9.16.0",
    "jsdom": "^30.0.1",
    "npm-run-all": "^4.1.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "^4.0.8"
  }
}
