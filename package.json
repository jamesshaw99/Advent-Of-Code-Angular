{
  "name": "advent-of-code",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "karma": "karma start",
    "generate-challenges": "node generate-challenge-imports.js",
    "start:frontend": "npm run generate-challenges && ng serve",
    "start:backend": "node ./backend/server.js",
    "start": "npm-run-all --parallel start:frontend start:backend",
    "lint": "eslint \"./src/**/*.{ts,html}\" \"./backend/*.{ts,js}\""
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.20",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.20",
    "@angular/compiler": "^21.2.20",
    "@angular/core": "^21.2.20",
    "@angular/forms": "^21.2.20",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.20",
    "@angular/platform-browser-dynamic": "^21.2.20",
    "@angular/router": "^21.2.20",
    "bootstrap": "^5.3.3",
    "rxjs": "~7.8.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.21",
    "@angular/cli": "^21.2.21",
    "@angular/compiler-cli": "^21.2.20",
    "@eslint/js": "^9.17.0",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^22.10.2",
    "angular-eslint": "21.4.0",
    "eslint": "^9.16.0",
    "jasmine-core": "~5.4.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-cli": "^2.0.0",
    "karma-coverage-istanbul-reporter": "^3.0.3",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "npm-run-all": "^4.1.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.67.0"
  }
}
